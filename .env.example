# ATLAS Environment Variables
# Do not put real API keys here, this is just an example file.

# ── AI Models ──────────────────────────────────
GROQ_API_KEY=                   # https://console.groq.com (free)
GEMINI_API_KEY=                 # https://aistudio.google.com (free)
ANTHROPIC_API_KEY=              # https://console.anthropic.com

# ── Database ───────────────────────────────────
DATABASE_URL=                   # https://neon.tech (free tier)

# ── Shopify Store (Step 3) ─────────────────────
# Get from: Shopify Admin → Settings → Apps → Develop apps → API credentials
SHOPIFY_STORE_URL=              # yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=           # shpat_xxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=         # From Shopify webhook settings (optional)

# ── Supplier APIs (Step 4) ─────────────────────
# DSers (AliExpress dropshipping) — https://developers.dsers.com/
DSERS_API_KEY=

# Spocket (US/EU suppliers, fast shipping) — https://app.spocket.co/integrations/api
SPOCKET_API_KEY=

# CJ Dropshipping — https://developers.cjdropshipping.com/
CJ_EMAIL=
CJ_API_KEY=                     # Your CJ account password (used as API key)

# AliExpress Open Platform (optional, for direct search)
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# ── Trading / On-chain (optional) ─────────────
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=
WALLET_PRIVATE_KEY=
TAVILY_API_KEY=
